# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required for any agent (generate / explore / triage / heal).
# Without it, agent-backed tests and CLIs skip rather than fail.
ANTHROPIC_API_KEY=

# Model used by the agents. Opus for hard reasoning, Sonnet for routine work.
HARNESS_MODEL=claude-sonnet-5

# Base URL of the app under test. The bundled example app runs on 4173.
BASE_URL=http://127.0.0.1:4173

# Rabbit-hole guards. Every agent run is bounded by all three; whichever
# trips first ends the run with a partial result rather than an open loop.
AGENT_MAX_TURNS=12
AGENT_MAX_USD=1.00
AGENT_TIMEOUT_MS=180000
