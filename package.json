{
  "name": "cc-pw-qe-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Claude + Playwright test harness for QA/QE work: AI-assisted test generation, exploratory agents, failure triage, and self-healing selectors.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:example": "playwright test tests/example",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "triage": "tsx src/cli/triage.ts",
    "assert-quality": "tsx src/cli/assert-quality.ts",
    "serve:fixture": "node fixtures-app/server.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.266",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.18.9",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
